# SkinCheck backend — copy to .env and fill in. NEVER commit .env.
# All values below are placeholders only. No real host, user, or
# password is written here.

# Application
APP_NAME=SkinCheck
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=<your-long-random-secret-key>

# Frontend (CORS) — comma-separated if more than one origin
# Production: the live Vercel origin, e.g. https://skincheck-frontend-robimhmmd-uxs-projects.vercel.app
FRONTEND_URL=http://localhost:3000

# Session cookie for cross-site production:
# - local: leave SESSION_SAME_SITE=lax
# - production (frontend on Vercel, API elsewhere): SESSION_SAME_SITE=none
#   (the app then forces Secure, as browsers require for SameSite=None)
SESSION_SAME_SITE=lax

# Database — MySQL / TiDB Cloud (MySQL-compatible)
# TiDB Cloud: DB_PORT=4000, DB_SSL=true
# Local MySQL/XAMPP: DB_PORT=3306, DB_SSL=false
DB_CONNECTION=mysql
DB_HOST=<your-database-host>
DB_PORT=4000
DB_DATABASE=skincheck_db
DB_USERNAME=<your-database-username>
DB_PASSWORD=<your-database-password>
DB_SSL=true
DB_SSL_CA=

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# Optional override for the scan upload folder (otherwise storage/scans,
# or /tmp/storage/scans when VERCEL=1):
# SKINCHECK_STORAGE_DIR=

# AI / assistant (optional — assistant endpoints need GEMINI_API_KEY)
LLM_PROVIDER=gemini
GEMINI_API_KEY=<your-gemini-api-key>
OPENAI_API_KEY=

# OTP / email gateway (optional — OTP email needs these)
MAIL_USERNAME=<your-email-address>
MAIL_PASSWORD=<your-email-app-password>
MAIL_FROM_NAME=SkinCheck AI
