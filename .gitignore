# Environment variables & secrets (CRITICAL: Do not remove)
.env
.env.*
!.env.example

# Database files
*.sqlite
*.sqlite3
*.db
test_skincheck.sqlite
skincheck_db.sqlite

# Media uploads & scans (keep folder structure via .gitkeep)
storage/scans/*
!storage/scans/.gitkeep
uploads/*
!uploads/.gitkeep

# Machine Learning weights (> 100MB exceeds GitHub hard limit)
facial-condition-model/*.h5
facial-condition-model/*.pth
facial-condition-model/*.pt
facial-condition-model/*.onnx
facial-condition-model/*.weights
kaggle_training/log_debug/

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Virtual Environments
venv/
.venv/
env/
ENV/

# IDE, Editor & MCP configs
.vscode/
.idea/
.agents/
.playwright-mcp/
skills-lock.json
